{
  "name": "b3-scraper",
  "version": "1.0.0",
  "description": "Mineração automatizada de editais B3 — valor global do contrato e remuneração da B3 (2020-2025)",
  "main": "src/cli.js",
  "type": "commonjs",
  "bin": {
    "b3-scraper": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "discover": "node src/cli.js discover",
    "download": "node src/cli.js download",
    "extract": "node src/cli.js extract",
    "report": "node src/cli.js report",
    "full": "node src/cli.js full",
    "test": "node tests/run.js",
    "lint": "node --check src/cli.js && node --check src/lib/*.js",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "fs-extra": "^11.2.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.45.0",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "B3 Scraper Project",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-org>/b3-scraper.git"
  },
  "keywords": [
    "b3",
    "scraper",
    "editais",
    "concessoes",
    "ppp",
    "playwright"
  ]
}
