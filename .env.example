# Anos a processar (separados por vírgula)
B3_ANOS=2024,2025

# Concorrência de downloads paralelos
B3_CONCURRENCY=3

# Tamanho do lote para extração
B3_BATCH_SIZE=5

# Diretório de cache (relativo à raiz)
B3_CACHE_DIR=cache

# Diretório de saída
B3_OUTPUT_DIR=output

# Timeout em ms para navegação e download
B3_NAV_TIMEOUT=60000
B3_DL_TIMEOUT=180000

# Delay entre downloads do mesmo host (ms) — anti rate-limit
B3_HOST_DELAY=600
